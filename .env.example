# ForenSync Environment Variables
# NOTE: All external variables are OPTIONAL. The app works fully out-of-the-box in standalone demo mode.

# Server Configuration (Defaults are pre-configured)
PORT=3000
SECRET_KEY=FORENSYNC_SUPER_SECRET_KEY_FOR_HACKATHON_2026

# Optional: Fast2SMS API Key (Leave blank to use built-in simulated OTP)
FAST2SMS_API_KEY=

# Optional: SMTP Email Configuration for Email OTP & Notifications (Leave blank for simulated logs)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Optional: Firebase Service Account JSON (Leave blank to use local built-in database & auth)
FIREBASE_CREDENTIALS=

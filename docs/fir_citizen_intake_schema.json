{
  "schema_name": "FIR_Citizen_Intake",
  "based_on": "NCRB I.I.F.-I (First Information Report, under Section 154 Cr.P.C.)",
  "notes": [
    "This schema covers ONLY fields the citizen can/should supply via the portal.",
    "Fields filled later by police (Act & Sections, GD entry, IO name, action taken, signatures, court fields) are intentionally excluded — those belong to the officer/system layer, not the citizen intake.",
    "'fir_item' shows which numbered item on the official IIF-I form this maps to, so the JSON output can be dropped straight into the FIR draft.",
    "Suggested Act & Sections should be generated by your AI matcher from 'incident.narrative' (see complaint_narrative), then confirmed by the recording officer — never auto-filled from citizen input alone."
  ],
  "sections": [
    {
      "section_id": "complainant_details",
      "title": "Your Details (Complainant / Informant)",
      "fir_item": "6",
      "fields": [
        { "id": "complainant_name", "label": "Full Name", "type": "text", "required": true, "fir_item": "6(a)" },
        { "id": "complainant_parent_spouse_name", "label": "Father's / Husband's Name", "type": "text", "required": true, "fir_item": "6(b)" },
        { "id": "complainant_dob", "label": "Date of Birth", "type": "date", "required": true, "fir_item": "6(c)" },
        { "id": "complainant_nationality", "label": "Nationality", "type": "text", "required": true, "default": "Indian", "fir_item": "6(d)" },
        { "id": "complainant_has_passport", "label": "Do you have a passport?", "type": "boolean", "required": false },
        { "id": "complainant_passport_no", "label": "Passport Number", "type": "text", "required": false, "condition": "complainant_has_passport == true", "fir_item": "6(e)" },
        { "id": "complainant_passport_issue_date", "label": "Passport Date of Issue", "type": "date", "required": false, "condition": "complainant_has_passport == true", "fir_item": "6(e)" },
        { "id": "complainant_passport_issue_place", "label": "Passport Place of Issue", "type": "text", "required": false, "condition": "complainant_has_passport == true", "fir_item": "6(e)" },
        { "id": "complainant_occupation", "label": "Occupation", "type": "text", "required": true, "fir_item": "6(f)" },
        { "id": "complainant_address", "label": "Address", "type": "textarea", "required": true, "fir_item": "6(g)" },
        { "id": "complainant_phone", "label": "Contact Phone Number", "type": "text", "required": true, "fir_item": null, "note": "Not on paper form but essential for portal follow-up/OTP verification" },
        { "id": "complainant_email", "label": "Email (optional)", "type": "text", "required": false, "fir_item": null }
      ]
    },
    {
      "section_id": "incident_timing",
      "title": "When Did It Happen",
      "fir_item": "3",
      "fields": [
        { "id": "incident_date_from", "label": "Incident Date (from)", "type": "date", "required": true, "fir_item": "3(a)" },
        { "id": "incident_date_to", "label": "Incident Date (to, if it happened over a period)", "type": "date", "required": false, "fir_item": "3(a)" },
        { "id": "incident_time_from", "label": "Incident Time (from)", "type": "time", "required": false, "fir_item": "3(a)" },
        { "id": "incident_time_to", "label": "Incident Time (to)", "type": "time", "required": false, "fir_item": "3(a)" },
        { "id": "incident_day", "label": "Day of the Week", "type": "select", "required": false, "auto_derive_from": "incident_date_from", "fir_item": "3(a)" },
        { "id": "reporting_delay_reason", "label": "If you're reporting this after some delay, briefly explain why", "type": "textarea", "required": false, "fir_item": "8" }
      ]
    },
    {
      "section_id": "place_of_occurrence",
      "title": "Where Did It Happen",
      "fir_item": "5",
      "fields": [
        { "id": "district", "label": "District", "type": "select", "required": true, "fir_item": "1" },
        { "id": "police_station", "label": "Police Station (nearest to incident location)", "type": "select", "required": true, "fir_item": "1", "note": "Auto-suggest based on geolocation/address; portal should confirm jurisdiction" },
        { "id": "occurrence_address", "label": "Exact Address / Landmark of Incident", "type": "textarea", "required": true, "fir_item": "5(b)" },
        { "id": "occurrence_direction_distance_from_ps", "label": "Direction & Distance from Police Station (if known)", "type": "text", "required": false, "fir_item": "5(a)" },
        { "id": "occurrence_geolocation", "label": "GPS Coordinates (auto-captured, if portal has location access)", "type": "geopoint", "required": false, "fir_item": null },
        { "id": "occurrence_outside_ps_limits", "label": "Did this happen outside this police station's jurisdiction?", "type": "boolean", "required": false, "fir_item": "5(c)" },
        { "id": "occurrence_actual_ps_name", "label": "If yes, name of the correct Police Station", "type": "text", "required": false, "condition": "occurrence_outside_ps_limits == true", "fir_item": "5(c)" },
        { "id": "occurrence_actual_district", "label": "If yes, name of the correct District", "type": "text", "required": false, "condition": "occurrence_outside_ps_limits == true", "fir_item": "5(c)" }
      ]
    },
    {
      "section_id": "complaint_narrative",
      "title": "What Happened",
      "fir_item": "12",
      "fields": [
        { "id": "incident_narrative", "label": "Describe what happened, in your own words", "type": "textarea", "required": true, "fir_item": "12", "note": "This is the primary text your AI section-matcher runs against to suggest applicable BNS sections" },
        { "id": "incident_category_hint", "label": "What best describes this incident?", "type": "select", "required": false, "options": ["Theft", "Robbery/Dacoity", "Assault/Hurt", "Cheating/Fraud", "Criminal Intimidation/Threat", "Property Damage", "Cybercrime", "Missing Person", "Other"], "note": "Optional citizen self-tag; used only as a soft signal for the AI matcher, never as the final section" }
      ]
    },
    {
      "section_id": "accused_details",
      "title": "About the Accused (fill in whatever you know — leave blank if unknown)",
      "fir_item": "7",
      "repeatable": true,
      "fields": [
        { "id": "accused_status", "label": "Is the accused known to you, suspected, or unknown?", "type": "select", "required": true, "options": ["Known", "Suspected", "Unknown"], "fir_item": "7" },
        { "id": "accused_name", "label": "Name (if known)", "type": "text", "required": false, "fir_item": "7" },
        { "id": "accused_address_or_description", "label": "Address / Identifying description", "type": "textarea", "required": false, "fir_item": "7" },
        { "id": "accused_sex", "label": "Sex", "type": "select", "options": ["Male", "Female", "Other", "Unknown"], "required": false, "fir_item": "Attachment to item 7 (col 1)" },
        { "id": "accused_approx_age_or_dob", "label": "Approximate Age / DOB", "type": "text", "required": false, "fir_item": "Attachment to item 7 (col 2)" },
        { "id": "accused_build", "label": "Build (e.g. thin, heavy, medium)", "type": "text", "required": false, "fir_item": "Attachment to item 7 (col 3)" },
        { "id": "accused_height_cm", "label": "Approximate Height (cm)", "type": "number", "required": false, "fir_item": "Attachment to item 7 (col 4)" },
        { "id": "accused_complexion", "label": "Complexion", "type": "text", "required": false, "fir_item": "Attachment to item 7 (col 5)" },
        { "id": "accused_identification_marks", "label": "Identification Mark(s)", "type": "text", "required": false, "fir_item": "Attachment to item 7 (col 6-7)" },
        { "id": "accused_dress", "label": "Dress at the time", "type": "text", "required": false, "fir_item": "Attachment to item 7 (col 13)" },
        { "id": "accused_language_dialect", "label": "Language/Dialect used (if heard)", "type": "text", "required": false, "fir_item": "Attachment to item 7" },
        { "id": "accused_vehicle_used", "label": "Vehicle used, if any (type, colour, number plate if seen)", "type": "text", "required": false, "fir_item": null }
      ]
    },
    {
      "section_id": "property_details",
      "title": "Property Stolen / Damaged (skip if not applicable)",
      "fir_item": "9,10",
      "repeatable": true,
      "fields": [
        { "id": "property_applicable", "label": "Was any property stolen, damaged, or lost?", "type": "boolean", "required": true },
        { "id": "property_description", "label": "Description of Property", "type": "textarea", "required": false, "condition": "property_applicable == true", "fir_item": "9" },
        { "id": "property_estimated_value", "label": "Estimated Value (Rs.)", "type": "number", "required": false, "condition": "property_applicable == true", "fir_item": "10" },
        { "id": "property_quantity", "label": "Quantity", "type": "text", "required": false, "condition": "property_applicable == true", "fir_item": "9" },
        { "id": "property_identification_marks", "label": "Any identifying marks / serial numbers", "type": "text", "required": false, "condition": "property_applicable == true", "fir_item": "9" }
      ]
    },
    {
      "section_id": "victim_details",
      "title": "Victim Details (only if different from complainant, e.g. reporting on someone else's behalf)",
      "fir_item": "IIF-II item 5",
      "repeatable": true,
      "fields": [
        { "id": "victim_same_as_complainant", "label": "Is the complainant also the victim?", "type": "boolean", "required": true },
        { "id": "victim_name", "label": "Victim's Name", "type": "text", "required": false, "condition": "victim_same_as_complainant == false" },
        { "id": "victim_parent_spouse_name", "label": "Victim's Father's/Husband's Name", "type": "text", "required": false, "condition": "victim_same_as_complainant == false" },
        { "id": "victim_dob", "label": "Victim's Date/Year of Birth", "type": "date", "required": false, "condition": "victim_same_as_complainant == false" },
        { "id": "victim_sex", "label": "Victim's Sex", "type": "select", "options": ["Male", "Female", "Other"], "required": false, "condition": "victim_same_as_complainant == false" },
        { "id": "victim_occupation", "label": "Victim's Occupation", "type": "text", "required": false, "condition": "victim_same_as_complainant == false" },
        { "id": "victim_address", "label": "Victim's Address", "type": "textarea", "required": false, "condition": "victim_same_as_complainant == false" },
        { "id": "victim_injury_type", "label": "Was the victim injured? (Grievous / Simple / None)", "type": "select", "options": ["None", "Simple", "Grievous"], "required": false },
        { "id": "victim_injury_cause", "label": "Means of causing injury (if any)", "type": "text", "required": false, "condition": "victim_injury_type != 'None'" }
      ]
    },
    {
      "section_id": "consent_and_declaration",
      "title": "Declaration",
      "fir_item": "14",
      "fields": [
        { "id": "declaration_true_to_knowledge", "label": "I declare the above information is true to the best of my knowledge", "type": "boolean", "required": true, "fir_item": "14" },
        { "id": "e_signature_or_otp_verification", "label": "E-signature / OTP verification token", "type": "text", "required": true, "fir_item": "14", "note": "Digital equivalent of the physical signature/thumb impression field" }
      ]
    }
  ],
  "excluded_officer_only_fields": {
    "note": "These IIF-I / IIF-II / IIF-III items are filled by police AFTER intake — do NOT collect these from the citizen portal.",
    "items": [
      "Item 2: Act & Sections (AI-suggested, officer-confirmed)",
      "Item 3(b): Information received at P.S. — system timestamp",
      "Item 3(c): General Diary reference — system generated",
      "Item 4: Type of Information (Written is implicit for portal filings)",
      "Item 11: Inquest Report/U.D. case number",
      "Item 13: Action taken",
      "Item 14 (officer half): Signature of Officer in charge",
      "Item 15: Date/time of despatch to court",
      "All of IIF-II Crime Details Form fields 4, 6, 8-11 (major/minor head, motive, IO's site visit, sketch) — investigation-stage only",
      "All of IIF-III Arrest/Court Surrender Form — post-arrest only",
      "All of IIF-IV Property Search & Seizure Form — investigation-stage only",
      "All of IIF-V Final Form/Report and Court Disposal/Appeal forms — post-investigation/judicial stage"
    ]
  }
}
